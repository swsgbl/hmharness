{
  "name": "@hmharness/cli",
  "version": "0.6.8",
  "description": "hmharness command line: one-shot tasks, an interactive REPL, a fullscreen TUI, the web frontend, and direct tool invocation.",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "types": "dist/main.d.ts",
  "bin": {
    "hmh": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "harmonyos",
    "openharmony",
    "ohos",
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "arkts",
    "self-evolving",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swsgbl/hmharness.git"
  },
  "homepage": "https://swsgbl.github.io/hmharness/",
  "bugs": "https://github.com/swsgbl/hmharness/issues",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hmharness/kernel": "0.6.8",
    "@hmharness/evolution": "0.6.8",
    "@hmharness/domain-harmony": "0.6.8",
    "@hmharness/domain-ops": "0.6.8",
    "@hmharness/agent": "0.6.8",
    "@hmharness/web": "0.6.8"
  }
}
